{
  "name": "backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "shopify:snapshot": "ts-node-dev --transpile-only --exit-child src/scripts/shopify-snapshot.ts",
    "shopify:restore": "ts-node-dev --transpile-only --exit-child src/scripts/shopify-restore.ts",
    "sync:verify": "ts-node-dev --transpile-only --exit-child src/scripts/sync-verify.ts",
    "test": "node --require ts-node/register/transpile-only --test \"src/**/*.test.ts\"",
    "sync:run": "ts-node --transpile-only src/scripts/sync-run.ts",
    "images:run": "ts-node --transpile-only src/scripts/images-run.ts",
    "images:dedupe": "ts-node --transpile-only src/scripts/images-dedupe.ts",
    "auth:set-password": "ts-node --transpile-only src/scripts/auth-set-password.ts",
    "secrets:init": "ts-node --transpile-only src/scripts/secrets-init.ts",
    "alert:test": "ts-node --transpile-only src/scripts/alert-test.ts",
    "db:check": "ts-node --transpile-only src/scripts/db-check.ts"
  },
  "description": "MEGADIGITAL API Server",
  "author": "Pedro Azevedo / Activelink",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.16.0",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "kysely": "0.28.19",
    "morgan": "^1.10.1",
    "nodemailer": "10.3.1",
    "openai": "^6.32.0",
    "tarn": "3.1.2",
    "tedious": "20.3.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.3.1",
    "@types/nodemailer": "8.0.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
