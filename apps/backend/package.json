{
  "name": "backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "import:esprinet": "ts-node-dev --transpile-only --exit-child src/scripts/import-esprinet.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "shopify:snapshot": "ts-node-dev --transpile-only --exit-child src/scripts/shopify-snapshot.ts",
    "shopify:restore": "ts-node-dev --transpile-only --exit-child src/scripts/shopify-restore.ts",
    "sync:verify": "ts-node-dev --transpile-only --exit-child src/scripts/sync-verify.ts",
    "test": "node --require ts-node/register/transpile-only --test \"src/**/*.test.ts\""
  },
  "description": "MEGADIGITAL API Server",
  "author": "Pedro Azevedo / Activelink",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.16.0",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "openai": "^6.32.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/basic-auth": "^1.1.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
