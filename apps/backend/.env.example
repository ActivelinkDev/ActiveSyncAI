NODE_ENV=production
PORT=3004

# ── Segurança e acesso (ver vault: Segurança) ──
# HTTPS: certificado interno gerado por deploy/windows/create-cert.ps1 (que preenche estas linhas).
# Sem HTTPS o backend só escuta no próprio PC (127.0.0.1).
TLS_PFX=
TLS_PFX_PASSPHRASE=
# Interface de rede onde escutar (por omissão 0.0.0.0 com HTTPS, 127.0.0.1 sem).
HOST=
# Sub-redes autorizadas (IP real do socket), separadas por vírgula. Ex.: 192.0.2.0/24, 198.51.100.0/24
# Vazio = qualquer rede interna (10.x, 172.16–31.x, 192.168.x); a internet nunca entra.
ALLOWED_SUBNETS=
# Chave das credenciais cifradas em data/ — gerada por: npm run secrets:init
SECRETS_KEY=
# Pasta da interface compilada (por omissão ../frontend/dist/frontend/browser)
FRONTEND_DIST=

# Pasta dos dados (SQLite + configs JSON). Caminho absoluto no servidor.
# Por omissão: apps/backend/data
DATA_DIR=C:\ActiveSyncAI\data

# Sync automático diário (importação Suprides → sync completo Shopify).
# Ligar SÓ no servidor — duas instâncias a escrever na mesma loja geram conflitos.
AUTO_SYNC_ENABLED=0
AUTO_SYNC_TIME=03:00

# OpenAI — tags por IA
OPENAI_API_KEY=

# Suprides API
SUPRIDES_URL=
SUPRIDES_USER=
SUPRIDES_PASS=
SUPRIDES_TOKEN=

# Shopify
SHOPIFY_STORE=
SHOPIFY_PASSWORD=
SHOPIFY_LOCATION_ID=

# ── Alertas por email (só em falhas) — npm run alert:test para testar ──
# Microsoft 365: SMTP_HOST=smtp.office365.com, SMTP_PORT=587, SMTP_SECURE=0
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
ALERT_FROM=
ALERT_TO=

# ── SQL Server (base de dados própria da app; login SQL só com acesso a esta BD) ──
# npm run db:check para testar a ligação e o isolamento
MSSQL_SERVER=
MSSQL_INSTANCE=
MSSQL_PORT=
MSSQL_DATABASE=ActiveSyncAI
MSSQL_USER=activesync_app
MSSQL_PASSWORD=
MSSQL_ENCRYPT=1
MSSQL_TRUST_CERT=1
